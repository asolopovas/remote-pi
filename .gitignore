# Build/download artifacts and caches (required source assets stay tracked)
*.apk
*.aab
*.ipa
*.dmg
*.exe
*.msi
*.deb
*.rpm
*.zip
*.tgz
coverage/
__pycache__/
*.pyc
rp-s3/data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts — pi-extension model-persist test writes a real settings.json
pi-extension/test/.pi/

# Per-cwd remote-pi runtime config (agent_name, auto_start_relay) — machine-local
# state written by `remote-pi claude` / the wizard, never repo content. Matches
# any `.pi/` dir at any depth (root, pi-extension/, subprojects).
.pi/

# Cockpit: tasks.json é versionado (config do Task Run); resto do .cockpit/ não
!.cockpit/
.cockpit/*
!.cockpit/tasks.json
graphify-out
.cockpit/worktrees/

# Material de divulgação (slides, PNGs exportados, copy de post). É conteúdo de
# campanha, não do produto: muda por rede social e por publicação, e os PNGs
# exportados são derivados dos .html. Fica local.
marketing/

openspec
