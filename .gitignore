# cmux / claude
.fresh/
.*
# Allow repository metadata; GitHub workflows are forbidden by project policy.
!.github/
!.gitleaksignore

# Historical/local coordination records; protocol contracts remain tracked.
/plan/
/review/
.orchestration/tasks/
.orchestration/results/

# Node
node_modules/
dist/
*.tsbuildinfo

# Rust
target/

# NextJS
.next/
out/
.vercel/

# Flutter / Dart
dockercache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.packages
.pub-cache/
.pub/

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
ios/Runner/GeneratedPluginRegistrant.*
ios/Flutter/ephemeral/

# Android
android/.gradle/
android/local.properties
android/app/release/
android/.kotlin/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# Editor
.vscode/
.idea/
*.iml
*.swp
.DS_Store

# Env / secrets
.env
.env.local
.env.*
!.env.example
!.env.sample
*.jks
*.keystore
*.p12
*.pfx
*.p8
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
